{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "npm run build:static",
  "outputDirectory": "static-site",
  "rewrites": [
    { "source": "/api/projects", "has": [{ "type": "query", "key": "lang", "value": "en" }], "destination": "/data/projects/en.json" },
    { "source": "/api/projects", "destination": "/data/projects/ko.json" },
    { "source": "/api/projects/:slug", "has": [{ "type": "query", "key": "lang", "value": "en" }], "destination": "/data/projects/:slug/en.json" },
    { "source": "/api/projects/:slug", "destination": "/data/projects/:slug/ko.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
