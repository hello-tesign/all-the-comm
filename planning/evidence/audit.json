        "tag": "H2",
        "text": "Start with core. Level up as you grow."
      },
      {
        "tag": "H2",
        "text": "Global workforce safety, with AI + digital."
      },
      {
        "tag": "H3",
        "text": "Detect risks. Assess impact. Act through one platform."
